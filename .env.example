# Copy to .env and adjust. CLI flags override these values.
JOBS_KEYWORDS=python,django
JOBS_CITY=Praha
# Also collect remote vacancies from anywhere in the country
JOBS_INCLUDE_REMOTE=true
JOBS_MAX_PAGES=3
JOBS_DB_PATH=data/jobs.db
JOBS_REQUEST_DELAY=1

# Hard filters (re-apply after changes: uv run jobservice filter)
# Reject only when a salary is published and its top is below this (EUR per month)
JOBS_MIN_SALARY_EUR=1500
# Minimum for the Ukrainian remote market (DOU, Djinni); empty = no salary filter there
JOBS_MIN_SALARY_EUR_UA=1000
# USD -> EUR for salaries in dollars (DOU); ECB rate on 2026-11-26 was 1.0975
JOBS_EUR_USD=1.10
# DOU.ua (Ukrainian remote market): categories and experience buckets (years) of its RSS feeds
JOBS_DOU_CATEGORIES=AI/ML,Data Science,Python,QA,HR
JOBS_DOU_EXPERIENCE=0-1,1-3
# Djinni (Ukrainian remote market): the site's category keys and experience levels of its RSS feeds.
# Keys must match the filter on djinni.co/jobs exactly; an unknown key is skipped with a warning.
JOBS_DJINNI_KEYWORDS=ML AI,Data Science,Python,QA,QA Automation,HR,Recruiter
JOBS_DJINNI_EXPERIENCE=no_exp,1y
# ČNB rate EUR→CZK used to compare CZK salaries
JOBS_EUR_CZK=24.4

# LLM scoring (uv run jobservice score): candidate profile text and optional model override
JOBS_PROFILE_PATH=data/profile.md
# JOBS_SCORE_MODEL=sonnet
# After scoring, reject vacancies whose best-track score is below this (empty = off)
JOBS_MIN_SCORE=50
# ...and those the model rates as a high entry barrier
JOBS_REJECT_HIGH_BARRIER=true

# Report by e-mail (jobservice report): Gmail address + Google app password
# (needs 2-Step Verification; https://myaccount.google.com/apppasswords).
# The report is only ever sent to this same address. Empty = macOS notification instead.
JOBS_GMAIL_ADDRESS=
JOBS_GMAIL_APP_PASSWORD=
